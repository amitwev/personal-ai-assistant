# Copy this file to .env and fill in the required values. Uncomment an optional key only to
# override its default.

# Telegram bot token from @BotFather
TelegramSettings__BotToken=

# Your own numeric Telegram chat ID, from @userinfobot.
# The bot ignores every other sender.
TelegramSettings__OwnerChatId=

# API key for the chat-completions endpoint AiSettings__BaseUrl points at.
AiSettings__ApiKey=

# Postgres password used by compose.yaml
POSTGRES_PASSWORD=

# Optional overrides below are commented out on purpose: a blank value here is NOT the same as
# an absent one. env_file loads a blank as an empty string, which overrides the appsettings.json
# default with an empty string, and the worker refuses to start. Leave a line commented to fall
# back to the default named above it; uncomment and set a value only to change it.

# Model slug to request. Defaults to google/gemini-3.1-flash-lite.
# AiSettings__Model=google/gemini-3.1-flash-lite

# Chat-completions endpoint base address. Defaults to OpenRouter; point this
# at any OpenAI-compatible endpoint instead (OpenAI, Groq, a local Ollama).
# AiSettings__BaseUrl=https://openrouter.ai/api/v1

# The zone every time the assistant reads or writes is in.
# Any IANA identifier; defaults to Asia/Jerusalem.
# TimeSettings__IanaTimeZone=Asia/Jerusalem
